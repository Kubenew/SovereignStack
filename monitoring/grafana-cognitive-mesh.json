  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "⚡ Real-Time Generation Speed (Tokens Per Second)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-mesh" },
          "editorMode": "code",
          "expr": "rate(sovereignstack_kernel_tokens_total[1m])",
          "legendFormat": "{{node_id}} ({{model}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "tps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "🛡️ Zero-Knowledge Alignment Verification Failures",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-mesh" },
          "expr": "sum by (values_uri) (rate(sovereignstack_policy_zk_failures_total[5m]))",
          "legendFormat": "Breach Attempt: {{values_uri}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "⏳ Active Autonomous Leases & Expiration Countdowns",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-mesh" },
          "expr": "sovereignstack_swarm_agent_lease_remaining_seconds",
          "legendFormat": "{{agent_uri}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s"
        }
      }
    }
  ],
  "refresh": "5s",
