{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kubenew/SovereignStack/main/schemas/oasa-audit-evidence.schema.json",
  "title": "OASA Audit Evidence Package",
  "description": "Schema for AI governance evidence packages — the output of `oasa-audit report`. Enables automated compliance verification against ISO 42001, EU AI Act, SOC 2, NIS2, and other frameworks.",
  "type": "object",
  "required": [
    "package_id", "timestamp", "node_id", "compliance_score",
    "framework_scores", "evidence_count", "merkle_root", "signed"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^audit-pkg://[a-zA-Z0-9-]+$",
      "description": "Unique evidence package identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report generation"
    },
    "node_id": {
      "type": "string",
      "pattern": "^node://",
      "description": "The SovereignStack node that generated this report"
    },
    "oasa_version": {
      "type": "string",
      "enum": ["2026.1"],
      "description": "Version of the OASA standard implemented"
    },
    "compliance_level": {
      "type": "string",
      "enum": ["READY_L1", "SECURE_L2", "STRICT_L3"],
      "description": "Current compliance tier of the node"
    },
    "compliance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall compliance score (0–100)"
    },
    "framework_scores": {
      "type": "object",
      "description": "Per-framework compliance scores",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["score", "controls_passed", "controls_total", "version"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "controls_passed": { "type": "integer", "minimum": 0 },
          "controls_total": { "type": "integer", "minimum": 1 },
          "version": { "type": "string" },
          "last_audit": { "type": "string", "format": "date-time" }
        }
      }
    },
    "controls": {
      "type": "object",
      "description": "Status of individual OASA CCM controls",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["pass", "fail", "na"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "last_verified": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "description": "Jurisdiction compliance status",
      "required": ["declared", "enforced", "data_transfers_blocked"],
      "properties": {
        "declared": { "type": "string", "description": "Declared jurisdiction (ISO 3166-1 alpha-2)" },
        "enforced": { "type": "boolean" },
        "data_transfers_blocked": { "type": "integer", "description": "Number of cross-jurisdiction transfers blocked" }
      }
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of evidence artifacts in this package"
    },
    "evidence_artifacts": {
      "type": "array",
      "description": "Evidence artifact references",
      "items": {
        "type": "object",
        "required": ["id", "type", "hash"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["audit_log", "provenance_graph", "ai_bom", "policy_evaluation", "network_scan", "runtime_log", "configuration"] },
          "hash": { "type": "string", "pattern": "^cas://" },
          "size_bytes": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Merkle root of all evidence artifacts for tamper verification"
    },
    "signed": {
      "type": "boolean",
      "const": true,
      "description": "Must be true — evidence packages are always signed"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "public_key", "value", "signed_at"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519", "ecdsa-p256"] },
        "public_key": { "type": "string" },
        "value": { "type": "string" },
        "signed_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "compliance_level": { "const": "STRICT_L3" } }
      },
      "then": {
        "properties": {
          "jurisdiction": {
            "properties": {
              "enforced": { "const": true }
            }
          },
          "controls": {
            "propertyNames": {
              "pattern": "^(NET-03|RUN-03|HW-03|AUD-03)$"
            }
          }
        }
      }
    }
  ]
}
