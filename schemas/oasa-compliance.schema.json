{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kubenew/SovereignStack/main/schemas/oasa-compliance.schema.json",
  "title": "OASA Sovereign Node Compliance Schema",
  "description": "Authoritative JSON Schema for validating Sovereign Node configurations against the Open Architecture Specification for Autonomous and Sovereign AI (OASA) v2026.1.",
  "type": "object",
  "required": [
    "oasa_version",
    "enforce_zero_exfiltration",
    "oasa_compliance_lock",
    "compliance_level",
    "air_gapped",
    "network",
    "encryption",
    "hardware_security",
    "compute",
    "ingestion",
    "audit",
    "api"
  ],
  "properties": {
    "oasa_version": {
      "type": "string",
      "enum": ["2026.1"],
      "description": "The exact version of the OASA standard implemented by the node."
    },
    "enforce_zero_exfiltration": {
      "type": "boolean",
      "const": true,
      "description": "Must be true to enforce absolute data isolation primitives."
    },
    "oasa_compliance_lock": {
      "type": "boolean",
      "description": "If true, dynamically blocks any public cloud API fallback loops upon local failure."
    },
    "compliance_level": {
      "type": "string",
      "enum": ["READY_L1", "SECURE_L2", "STRICT_L3"],
      "description": "The target OASA compliance tier for certification mapping."
    },
    "air_gapped": {
      "type": "boolean",
      "description": "Declares if the host node is running inside a physically or logically air-gapped network segment."
    },
    "network": {
      "type": "object",
      "required": ["allow_wan", "allowed_egress_cidrs", "dns_mode"],
      "properties": {
        "allow_wan": {
          "type": "boolean",
          "description": "Defines if wide-area network traffic is permitted. Controlled by NET-01."
        },
        "allowed_egress_cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(\\/([0-9]|[1-2][0-9]|3[0-2]))$"
          },
          "description": "Strict whitelist of internal IPv4 CIDRs allowed for deployment node integration."
        },
        "dns_mode": {
          "type": "string",
          "enum": ["LOCAL_ONLY", "HYBRID", "DISABLED"],
          "description": "DNS validation behavior matching control standard NET-03."
        }
      }
    },
    "encryption": {
      "type": "object",
      "required": ["algorithm", "key_management", "key_rotation_days"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["AES-256-GCM", "CHACHA20-POLY1305"],
          "description": "Cryptographic standard enforced for localized context data and KV-caches."
        },
        "key_management": {
          "type": "string",
          "enum": ["LOCAL_FILE", "TPM_2.0", "HSM_EXTERNAL"],
          "description": "Key storage framework topology mapping to HW-03."
        },
        "key_rotation_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "hardware_security": {
      "type": "object",
      "required": ["tpm_required", "tpm_version", "secure_boot"],
      "properties": {
        "tpm_required": { "type": "boolean" },
        "tpm_version": { "type": "string", "enum": ["2.0", "NONE"] },
        "hsm_type": { "type": "string" },
        "secure_boot": { "type": "boolean" }
      }
    },
    "compute": {
      "type": "object",
      "required": ["vram_budget_gb", "quantization_formats", "accelerator_backends"],
      "properties": {
        "vram_budget_gb": {
          "type": "integer",
          "minimum": 4,
          "maximum": 2048,
          "description": "Maximum physical memory threshold matching compute specifications."
        },
        "quantization_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["FP16", "INT8", "INT4", "INT2", "AWQ", "GPTQ"]
          }
        },
        "accelerator_backends": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["NVIDIA_CUDA", "APPLE_METAL", "AMD_ROCM", "CPU"]
          }
        }
      }
    },
    "ingestion": {
      "type": "object",
      "required": ["allow_disk_cache", "supported_formats"],
      "properties": {
        "allow_disk_cache": {
          "type": "boolean",
          "description": "Must be false for L2/L3 compliance to enforce volatile-only parsing (HW-01)."
        },
        "supported_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["PDF", "TIFF", "DOCX", "HTML", "TXT", "JSON"]
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["enabled", "log_format", "immutable", "retention_days"],
      "properties": {
        "enabled": { "type": "boolean" },
        "log_format": { "type": "string", "enum": ["JSON", "SYSLOG"] },
        "immutable": { "type": "boolean", "description": "Forces log immutability via control AUD-03." },
        "retention_days": { "type": "integer", "minimum": 30 }
      }
    },
    "api": {
      "type": "object",
      "required": ["openai_compatible", "base_url", "endpoints"],
      "properties": {
        "openai_compatible": { "type": "boolean", "const": true },
        "base_url": { "type": "string", "format": "uri" },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["/v1/chat/completions", "/v1/embeddings", "/v1/models"]
          }
        }
      }
    }
  },
  "dependentRequired": {
    "air_gapped": ["network"]
  },
  "allOf": [
    {
      "if": {
        "properties": { "compliance_level": { "const": "STRICT_L3" } }
      },
      "then": {
        "properties": {
          "air_gapped": { "const": true },
          "network": {
            "properties": {
              "allow_wan": { "const": false },
              "dns_mode": { "const": "LOCAL_ONLY" }
            }
          },
          "encryption": {
            "properties": {
              "key_management": { "const": "TPM_2.0" }
            }
          },
          "hardware_security": {
            "properties": {
              "tpm_required": { "const": true },
              "tpm_version": { "const": "2.0" },
              "secure_boot": { "const": true }
            }
          },
          "ingestion": {
            "properties": {
              "allow_disk_cache": { "const": false }
            }
          },
          "audit": {
            "properties": {
              "immutable": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "compliance_level": { "const": "SECURE_L2" } }
      },
      "then": {
        "properties": {
          "network": {
            "properties": {
              "allow_wan": { "const": false }
            }
          },
          "ingestion": {
            "properties": {
              "allow_disk_cache": { "const": false }
            }
          }
        }
      }
    }
  ]
}
