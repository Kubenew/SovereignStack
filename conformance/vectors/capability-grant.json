{
  "id": "CAP-001",
  "version": "0.5.0",
  "description": "Capability grant and verification",
  "canonicalization": "JCS (RFC 8785)",
  "cryptographic_algorithm": "Ed25519",
  "hash_algorithm": "SHA-256",
  "inputs": {
    "capability_uri": "cap://uuid-1234",
    "granted_by": "org://foundation",
    "granted_to": "agent://alice",
    "permissions": ["read", "write"],
    "target": "knowledge://domain/physics",
    "expires_at": 1786435200,
    "max_uses": 2,
    "signing_key_hex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
  },
  "expected_outputs": {
    "grant_valid": true,
    "check_read_allowed": true,
    "check_execute_allowed": false
  },
  "failure_conditions": [
    {
      "name": "expired",
      "mutation": "set timestamp > expires_at",
      "expected_error": "CapabilityDenied(Expired)"
    },
    {
      "name": "max_uses_exceeded",
      "mutation": "consume capability 3 times",
      "expected_error": "CapabilityDenied(Exhausted)"
    }
  ]
}
