# SovereignStack Playground
# Copy to .env and adjust for your environment.

# Compliance level: STRICT | PERMISSIVE | AUDIT_ONLY
OASA_COMPLIANCE_LEVEL=STRICT

# Lock mode: BLOCK external API calls on local failure
OASA_LOCK_ON_FAILURE=BLOCK

# Inference engine: vllm | llama.cpp
INFERENCE_BACKEND=vllm

# Model to load (for vLLM: HuggingFace model name; for llama.cpp: GGUF path)
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LLAMA_MODEL_PATH=./models/model.gguf

# GPU configuration
VLLM_GPU_COUNT=1
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTIL=0.90

# API keys (set if using external verification services)
OIDC_CLIENT_ID=sovereign-gateway
OIDC_CLIENT_SECRET=
